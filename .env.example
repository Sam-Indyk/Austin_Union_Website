# Copy to .env.local and fill in. Never commit .env.local.
#
# Local development: `npm run db:start` prints these values (or run
# `npx supabase status -o env`).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Permanent admins. People separated by ";", each person's addresses by ","
# (all of one person's addresses sign in to the same account). `npm run db:seed`
# creates them, and signing in with any of these addresses always restores
# admin access — put the society's permanent account here (docs/OPERATIONS.md).
ADMIN_EMAILS=

# Email the site sends itself (codes, RSVP confirmations). Local: Mailpit.
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM="Austin Union <events@austinunion.org>"

# Secret used to derive anonymous voter keys (any long random string).
VOTE_SECRET=

# Secret for /api/cron/dispatch, which sends scheduled emails (any long random
# string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Optional: Swoogo API credentials from UATX (My Profile > API Credentials).
# When set, RSVPs to UATX-hosted events are registered with Swoogo automatically.
SWOOGO_CONSUMER_KEY=
SWOOGO_CONSUMER_SECRET=

# Google sign-in (read by supabase/config.toml; put these in supabase/.env)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Shows the "Continue with Google" button once the provider is set up.
# NEXT_PUBLIC_GOOGLE_SIGNIN=on
